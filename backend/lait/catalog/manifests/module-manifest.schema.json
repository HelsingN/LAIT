{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lait.local/schemas/module-manifest.schema.json",
  "title": "Universal module manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "module_id",
    "module_version",
    "api_version",
    "category",
    "capabilities",
    "dependencies"
  ],
  "properties": {
    "module_id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "module_version": { "type": "string", "minLength": 1 },
    "api_version": { "type": "integer", "const": 1 },
    "publisher": { "type": "string" },
    "category": { "type": "string", "enum": ["exercise"] },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
