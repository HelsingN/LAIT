APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
WEB_PORT=5173
# Read by the application outside Compose. Default file is data/lait.db.
# Compose overrides this inside the api service to sqlite:////app/data/lait.db
# on the app-data volume. Do not point the container at a host SQLite file.
LAIT_DATABASE_URL=sqlite:///./data/lait.db
DATABASE_URL=sqlite:///./data/lait.db
AI_PROVIDER=openai_compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
VITE_API_BASE_URL=http://localhost:8000
